# 09_unified: qué no se versiona.
#
# El .gitignore raíz ignora runs/; aquí se reincluye, porque las corridas de 09 cuestan dinero y no se repiten
# idénticas (el proponente es un LLM). Se versionan los registros livianos (meta.json, episodios.jsonl,
# attempts.jsonl, memoria.json, LEEME.md, logs de texto, libro de gastos) y se excluyen los pesados, que los
# informes citan por su SHA-256.
!runs/

# entorno y cachés
.venv/
*.egg-info/
__pycache__/
.pytest_cache/

# registros pesados: el texto completo de cada llamada al modelo (hasta 1,5 MB por corrida)
runs/**/llamadas.jsonl

# caché binaria del martillo, candados y pid
logs/*.sqlite
logs/*.lock
logs/**/*.pid

# pruebas de referencia privadas: el repositorio es público y el proponente nunca debe verlas (PLAN §1, punto 7)
tests/fixtures/pruebas_privadas/

# temporales de LaTeX
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
docs/**/*.log
